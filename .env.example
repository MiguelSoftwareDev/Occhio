OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
GRPC_ADDRESS=127.0.0.1:50051
RABBITMQ_URL=amqp://occhio:occhio_demo@127.0.0.1:5672/
DATABASE_PATH=data/occhio.db
ANALYSIS_TIMEOUT_SECONDS=120

# Optional deployment label; otherwise the collector detects the OS/container.
# OCCHIO_ENVIRONMENT=Development workstation
# Explicit hosts and browser origins for a controlled deployment (loopback by default).
# OCCHIO_ALLOWED_HOSTS=localhost,127.0.0.1,monitor.example.internal
# OCCHIO_ALLOWED_ORIGINS=https://monitor.example.internal
